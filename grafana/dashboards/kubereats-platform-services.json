  "panels": [
    {
      "id": 1,
      "title": "CoreDNS Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(up{job=\"coredns\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "CoreDNS Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(rate(coredns_dns_responses_total{rcode=~\"SERVFAIL|REFUSED|FORMERR\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingress 4xx / 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{status=~\"4..\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{status=~\"5..\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "5xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ingress p95 Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket[5m])) by (le))",
          "instant": false,
          "range": true,
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
