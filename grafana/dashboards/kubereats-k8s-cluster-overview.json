  "panels": [
    {
      "id": 1,
      "title": "Ready Nodes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pods by Phase",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum by (phase) (kube_pod_status_phase)",
          "instant": true,
          "range": false,
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Deployments Desired vs Available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(kube_deployment_spec_replicas)",
          "instant": false,
          "range": true,
          "legendFormat": "desired",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_available)",
          "instant": false,
          "range": true,
          "legendFormat": "available",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cluster CPU Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "cores",
          "refId": "A"
        }
      ]
    },
