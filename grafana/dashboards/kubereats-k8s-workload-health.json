    },
    {
      "id": 6,
      "title": "OOMKilled Containers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum by (namespace,pod,container) (increase(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}[6h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}",
          "refId": "A"
        }
      ]
    },
    {
