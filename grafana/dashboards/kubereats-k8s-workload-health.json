  "panels": [
    {
      "id": 1,
      "title": "Unavailable Deployment Replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "kube_deployment_status_replicas_unavailable",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}/{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "CrashLoopBackOff Pods",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Restart Count by Namespace/Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "sum by (namespace,pod) (increase(kube_pod_container_status_restarts_total[30m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pending Pods",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes-prometheus"
          },
          "expr": "kube_pod_status_phase{phase=\"Pending\"} == 1",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
