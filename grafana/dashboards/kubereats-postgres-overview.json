        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "expr": "pg_up{job=\"postgres-exporter\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Up/Down by Node",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (node) (pg_stat_activity_count{datname!~\"template.*\"})",
          "legendFormat": "{{node}} current",
          "refId": "A"
        },
        {
          "expr": "max by (node) (pg_settings_max_connections)",
          "legendFormat": "{{node}} max",
          "refId": "B"
        }
      ],
      "title": "DB Connections Current vs Max",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
