      },
      "targets": [
        {
          "expr": "sum by (node) (rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[5m]))",
          "legendFormat": "{{node}} commits",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (rate(pg_stat_database_xact_rollback{datname!~\"template.*\"}[5m]))",
          "legendFormat": "{{node}} rollbacks",
